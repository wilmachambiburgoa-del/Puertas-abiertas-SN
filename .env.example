# Neon Database (obtén esto en https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret (genera uno seguro, ej: openssl rand -base64 32)
JWT_SECRET=tu_secreto_jwt_muy_seguro_aqui

# Vercel Blob (para subir imágenes - opcional pero recomendado)
# En Vercel Dashboard > Storage > Blob > Create, luego copia el token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
